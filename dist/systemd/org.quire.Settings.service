# Settings (detent) as a systemd user unit: the unit accountd and inferd know Settings by.
# Both give the Settings role only to this unit's main process, so a detent started any other way
# (a terminal, an app scope, another unit) is an ordinary app with no Settings role. It is found,
# and started, by D-Bus activation (dbus-1/services/org.quire.Settings.service) when an intent
# addresses org.quire.Settings. `--service` runs it with no window and no focus; an action that
# shows something opens the window, and the process leaves after a while with none.
[Unit]
Description=Settings (org.quire.Settings)

[Service]
Type=dbus
BusName=org.quire.Settings
ExecStart=/usr/bin/detent --service
# Settings holds the Settings role in full proof only when the unit clears every loader variable
# (the list is peephole-core's LOADER_VARIABLES), so no environment can load code into it.
UnsetEnvironment=LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT GCONV_PATH GIO_EXTRA_MODULES GTK_MODULES GTK_PATH GST_PLUGIN_PATH GST_PLUGIN_SYSTEM_PATH LIBGL_DRIVERS_PATH MESA_LOADER_DRIVER_OVERRIDE __EGL_VENDOR_LIBRARY_DIRS __EGL_VENDOR_LIBRARY_FILENAMES GBM_BACKENDS_PATH LIBVA_DRIVERS_PATH VK_ICD_FILENAMES VK_DRIVER_FILES VK_ADD_DRIVER_FILES VK_LAYER_PATH VK_ADD_LAYER_PATH VK_INSTANCE_LAYERS VK_LOADER_LAYERS_ENABLE
